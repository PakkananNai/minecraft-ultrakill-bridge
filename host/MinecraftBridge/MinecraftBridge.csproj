<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MinecraftBridge</AssemblyName>
    <RootNamespace>MinecraftBridge</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir>$(HOME)/Downloads/ULTRAKILL.v2026.04.25/ULTRAKILL.v2026.04.25</GameDir>
    <BepInExCore>$(GameDir)/BepInEx/core</BepInExCore>
    <ManagedDir>$(GameDir)/ULTRAKILL_Data/Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx 6 Core Assemblies -->
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExCore)/BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.Mono">
      <HintPath>$(BepInExCore)/BepInEx.Unity.Mono.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity Engine Core Assemblies -->
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
